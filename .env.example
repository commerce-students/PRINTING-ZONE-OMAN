# Copy to .env.local and adjust. Never commit real secrets.

# Canonical public URL of the site. Used for metadata, canonical tags, the
# sitemap and JSON-LD structured data.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Absolute path where orders, enquiries, carts and uploaded artwork are stored.
# Must live OUTSIDE public/ so nothing is web-reachable. Defaults to ./var.
# DATA_DIR=/absolute/path/to/private/store

# When a payment provider and email service are connected, their credentials go
# here (server-side only — never prefixed with NEXT_PUBLIC_):
# PAYMENT_PROVIDER_KEY=
# PAYMENT_PROVIDER_WEBHOOK_SECRET=
# EMAIL_SERVICE_API_KEY=
# EMAIL_FROM_ADDRESS=
# EMAIL_ORDER_NOTIFICATION_TO=
